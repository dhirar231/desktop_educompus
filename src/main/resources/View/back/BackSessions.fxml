<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.embed.swing.SwingNode?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.educompus.controller.back.BackSessionsController"
      fx:id="root"
      styleClass="content" spacing="16">
    <padding>
        <Insets top="22" right="22" bottom="22" left="22"/>
    </padding>

    <VBox spacing="4">
        <Label text="Sessions Live" styleClass="page-title"/>
        <Label text="Gestion des sessions live: création, affichage et synchronisation Google Calendar." styleClass="page-subtitle" wrapText="true"/>
        <Label fx:id="accessLabel" text="Acces reserve a l'enseignant. L'administrateur n'a pas acces aux sessions." style="-fx-text-fill: #d6293e; -fx-font-weight: 700;" visible="false" managed="false" wrapText="true"/>
    </VBox>

    <!-- Onglets pour Meeting et Sessions Live -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- Onglet Meeting Jitsi -->
        <Tab text="Meeting Jitsi" closable="false">
            <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="Meeting Jitsi" styleClass="stat-title"/>
                <Label text="Le meeting reste dans l'application via Chromium integre." styleClass="page-subtitle" wrapText="true"/>
                <TextField fx:id="meetingTitleField" promptText="Titre optionnel ex: Soutenance GL" styleClass="field"/>
                <TextField fx:id="meetingRoomField" promptText="Room ID optionnel ex: soutenance-gl-2026" styleClass="field"/>
                <TextField fx:id="meetingLinkField" promptText="Lien meeting" styleClass="field" editable="false"/>
                <Label fx:id="meetingMetaLabel" text="Aucune salle generee." styleClass="page-subtitle" wrapText="true"/>
                <VBox styleClass="card" prefHeight="560" VBox.vgrow="ALWAYS">
                    <SwingNode fx:id="meetingBrowserHost" VBox.vgrow="ALWAYS"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="10">
                    <Button text="Generer et charger" onAction="#createMeeting" styleClass="btn-rgb"/>
                    <Button text="Charger la salle" onAction="#loadMeeting" styleClass="btn-rgb-outline"/>
                    <Button text="Copier lien" onAction="#copyMeetingLink" styleClass="btn-rgb-outline"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- Onglet Sessions Live -->
        <Tab text="Sessions Live" closable="false">
            <VBox spacing="12" VBox.vgrow="ALWAYS">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                
                <!-- Formulaire de création -->
                <VBox styleClass="card" spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Créer une nouvelle session live" styleClass="stat-title"/>
                    
                    <TextField fx:id="sessionCoursNameField" promptText="Nom du cours" styleClass="field"/>
                    
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="sessionLinkField" promptText="Lien de la session (Google Meet, Zoom, etc.)" styleClass="field" HBox.hgrow="ALWAYS"/>
                        <Button text="🔗 Générer Google Meet" onAction="#generateGoogleMeetLink" styleClass="btn-rgb-outline"/>
                    </HBox>
                    
                    <HBox spacing="10">
                        <Label text="Date:" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="sessionDatePicker" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    
                    <HBox spacing="10">
                        <Label text="Heure:" style="-fx-font-weight: bold;"/>
                        <Spinner fx:id="sessionHourSpinner" prefWidth="80"/>
                        <Label text=":"/>
                        <Spinner fx:id="sessionMinuteSpinner" prefWidth="80"/>
                    </HBox>
                    
                    <Button text="Créer la session" onAction="#createSessionLive" styleClass="btn-rgb"/>
                </VBox>
                
                <!-- Liste des sessions -->
                <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <HBox spacing="10">
                        <Label text="Sessions enregistrées" styleClass="stat-title"/>
                        <Label fx:id="sessionsCountLabel" text="Total: 0 | Actives: 0" style="-fx-text-fill: #666;"/>
                    </HBox>
                    
                    <ListView fx:id="sessionsListView" VBox.vgrow="ALWAYS" prefHeight="300"/>
                    
                    <HBox spacing="10">
                        <Button text="Démarrer" onAction="#startSelectedSession" styleClass="btn-rgb"/>
                        <Button text="Terminer" onAction="#endSelectedSession" styleClass="btn-rgb-outline"/>
                        <Button text="Supprimer" onAction="#deleteSelectedSession" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
